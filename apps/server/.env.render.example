# Render NIE wczytuje plików .env z repo — to plik referencyjny (Blueprint w render.yaml
# poprosi Cię o te same 3 wartości w formularzu przy pierwszym deployu).
# Ręcznie: Render → Twój serwis → Environment → Add Environment Variable

NODE_ENV=production

# Hasło do panelu /bingo/admin
ADMIN_PASSWORD=ustaw-wlasne-haslo

# Długi losowy ciąg do podpisywania sesji admina (JWT) — wygeneruj np. przez:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=wygeneruj-dlugi-losowy-ciag

# Adres frontendu na Netlify (bez ukośnika na końcu). Kilka adresów po przecinku,
# jeśli testujesz i produkcyjny URL i deploy-preview.
CORS_ORIGIN=https://TWOJA-STRONA.netlify.app

# PORT ustawia Render automatycznie — nie trzeba go tu wpisywać.
