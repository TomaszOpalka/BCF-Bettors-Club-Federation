# Skopiuj do apps/server/.env i ustaw własne wartości.

# Port backendu (frontend w dev proxuje na niego /api oraz /socket.io)
PORT=4000

# Hasło do panelu admina bingo (/bingo/admin)
ADMIN_PASSWORD=zmien-to-haslo

# Sekret do podpisywania JWT sesji admina - dowolny długi losowy ciąg
JWT_SECRET=zmien-to-na-dlugi-losowy-ciag

# Dozwolone originy dla CORS (po przecinku). W dev Vite chodzi na 5173.
CORS_ORIGIN=http://localhost:5173
