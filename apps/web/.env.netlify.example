# Netlify NIE wczytuje plików .env z repo przy buildzie - to plik referencyjny.
# Wartości poniżej wklej ręcznie w:
# Netlify → Site configuration → Environment variables → Add a variable

# Adres backendu na Render, np. https://bcf-server.onrender.com (bez ukośnika na końcu)
VITE_SERVER_URL=https://TWOJ-BACKEND.onrender.com
